# ==============================================================================
# SMART ENERGY MONITORING DASHBOARD - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure with your EMQX credentials.
# NOTE: Never commit .env with real credentials into source control.
# ==============================================================================

# Backend Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# EMQX MQTT Broker Configuration
MQTT_HOST=mqtt.dev.geotechs.in
MQTT_PORT=1883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
# Optional MQTT protocol: 'mqtt' for TCP (port 1883) or 'mqtts' for TLS (port 8883)
MQTT_PROTOCOL=mqtt
# Optional client ID prefix
MQTT_CLIENT_ID_PREFIX=smart_energy_dashboard

# MQTT Subscription Topics
TELEMETRY_TOPIC=energy/monitor/telemetry
STATUS_TOPIC=energy/monitor/status
ALERT_TOPIC=energy/monitor/alerts

# Telemetry Staleness & Memory Limits
# Number of milliseconds before telemetry is labeled STALE if no new valid readings arrive
STALENESS_TIMEOUT_MS=5000
# Maximum in-memory historical points preserved for charts
MAX_HISTORY_POINTS=200

# Development / Testing Utility
# Set to 'true' only in local development to enable POST /api/test/telemetry for pipeline verification
ALLOW_TEST_INJECTION=true
